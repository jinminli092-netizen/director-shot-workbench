# Local-only defaults. Copy to .env and edit.
SEEDANCE_HOST=127.0.0.1
SEEDANCE_PORT=8765
SEEDANCE_DATA_DIR=./data
SEEDANCE_MAX_UPLOAD_MB=4096

# Optional: any OpenAI-compatible vision endpoint.
# SEEDANCE_MODEL_BASE_URL=https://your-endpoint.example/v1
# SEEDANCE_MODEL=your-vision-model
# SEEDANCE_API_KEY=sk-...
# SEEDANCE_MODEL_NAME=my-vision
