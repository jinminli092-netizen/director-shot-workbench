# Local-only defaults. Copy to .env and edit.
SEEDANCE_HOST=127.0.0.1
SEEDANCE_PORT=8765
SEEDANCE_DATA_DIR=./data
SEEDANCE_MAX_UPLOAD_MB=4096

# Cut provider: local (free, ffmpeg scdet) or volcengine (paid, recommended).
# The UI can also switch per video.
SEEDANCE_CUT_PROVIDER=local

# --- Analysis model: pick one provider, then fill the model + key ---
# doubao | deepseek | kimi | custom
SEEDANCE_MODEL_PROVIDER=doubao

# Doubao / Volcengine ARK example:
# SEEDANCE_MODEL=doubao-seed-2-1-pro-vision-...   (use the endpoint/model ID from your ARK console)
# SEEDANCE_API_KEY=...
#
# DeepSeek example:
# SEEDANCE_MODEL_PROVIDER=deepseek
# SEEDANCE_MODEL=your-vision-capable-model
# SEEDANCE_API_KEY=...
#
# Kimi / Moonshot example:
# SEEDANCE_MODEL_PROVIDER=kimi
# SEEDANCE_MODEL=your-vision-capable-model
# SEEDANCE_API_KEY=...
#
# Any other OpenAI-compatible endpoint:
# SEEDANCE_MODEL_PROVIDER=custom
# SEEDANCE_MODEL_BASE_URL=https://your-endpoint.example/v1
# SEEDANCE_MODEL=your-vision-model
# SEEDANCE_API_KEY=...

# Optional cloud cut: Volcengine AI MediaKit (semantic-segment-pro)
# SEEDANCE_VOLCENGINE_API_KEY=...
# SEEDANCE_VOLCENGINE_BASE_URL=https://mediakit.cn-beijing.volces.com/api/v1
